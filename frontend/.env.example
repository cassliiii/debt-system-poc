# URL base de la API de consulta.
# Déjela vacía para usar el mismo origen: el proxy de desarrollo reenvía /api
# a http://localhost:8080.
VITE_API_URL=

# Modo mock de la consulta.
# true = usa datos simulados de src/services/mock/ y no requiere backend.
# false = consume la API real de consulta.
VITE_USE_MOCK=false

# Modo mock de la ingesta.
# true = usa el servicio simulado de ingesta.
# false = consume el backend real ingesta-demo.
VITE_USE_MOCK_INGESTA=true

# URL base del servicio de ingesta.
# Déjela vacía para usar el mismo origen: el proxy de desarrollo reenvía
# /ingestas a http://localhost:8081.
VITE_INGESTA_BASE_URL=

# Tamaño máximo permitido para la carga del CSV, en MB.
VITE_MAX_UPLOAD_MB=500
